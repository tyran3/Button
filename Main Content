<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="f-button.svg">
  <title>Pirate Shop Token Clicker</title>
  <style>
    *{box-sizing:border-box}body{min-height:100vh;margin:0;display:grid;place-items:center;overflow:hidden;background:#f4f4f5;color:#18181b;font-family:system-ui,sans-serif}button{font:inherit;cursor:pointer}#reset-progress,#clock-toggle,#action-button,.bonus-button,.toggle-button,.clear-key,#password-submit,.edge-toggle,.bubble,.reset-dialog,.final-dialog{user-select:none}img{display:block;max-width:100%}#count,#timer-label,#event-status{font-weight:700}#time-panel{display:none;max-width:min(80vw,540px);padding:0 1rem;opacity:0;transition:opacity .2s ease,transform .2s ease}#time-panel.open{display:block;opacity:1;transform:translateY(0)}#reset-progress{position:fixed;top:1rem;left:1rem;z-index:40;padding:.8rem 1.1rem;border:0;border-radius:999px;background:#18181b;color:#fff;box-shadow:0 10px 30px rgba(24,24,27,.2)}#reset-progress:hover{transform:translateY(-1px)}#clock-toggle{position:fixed;top:1rem;right:1rem;z-index:40;padding:.8rem .9rem;border:0;border-radius:999px;background:#fff;box-shadow:0 8px 22px rgba(24,24,27,.12)}main{display:grid;place-items:center;gap:1rem;padding:2rem 1rem;position:relative;z-index:1}#action-button{border:0;border-radius:999px;width:min(42vw,240px);height:min(42vw,240px);background:linear-gradient(135deg,#f6d365,#fda085);box-shadow:0 20px 40px rgba(249,115,22,.3),0 0 0 16px rgba(255,255,255,.7);display:grid;place-items:center;padding:0;transition:transform .08s ease,box-shadow .2s ease}#action-button:active{transform:scale(.97);box-shadow:0 12px 24px rgba(249,115,22,.25),0 0 0 12px rgba(255,255,255,.7)}#action-button img{width:74%}#event-status{position:fixed;bottom:1.25rem;left:50%;transform:translateX(-50%);margin:0;width:min(90vw,760px);text-align:center;padding:.9rem 1.2rem;border-radius:999px;background:rgba(255,255,255,.7);backdrop-filter:blur(12px);box-shadow:0 8px 22px rgba(24,24,27,.08)}.drawer{position:fixed;top:50%;transform:translateY(-50%);z-index:30}.drawer#rebirth-drawer{right:1rem}.drawer#access-drawer{left:1rem}.drawer .edge-toggle{display:flex;align-items:center;justify-content:center;width:2.75rem;height:2.75rem;border:0;border-radius:50%;background:#18181b;color:#fff;box-shadow:0 10px 30px rgba(24,24,27,.2);font-size:1.4rem}.drawer .rebirth-list,.drawer .access-content{display:none;padding:1rem;border-radius:1rem;background:rgba(255,255,255,.9);backdrop-filter:blur(10px);box-shadow:0 14px 28px rgba(24,24,27,.12)}.drawer.open .rebirth-list,.drawer.open .access-content{display:block}.drawer.open .edge-toggle{background:#111827;color:#f9fafb}.bubble{padding:.75rem .9rem;border:1px solid rgba(24,24,27,.08);border-radius:.85rem;background:rgba(255,255,255,.7);margin-bottom:.65rem}.bubble p,.bubble small{margin:0}.bubble small{display:block;color:#4b5563;margin-top:.3rem}.auto-row{display:flex;align-items:center;justify-content:space-between;gap:1rem}.toggle-button,.bonus-button,.clear-key,#password-submit{padding:.65rem .8rem;border:0;border-radius:.7rem;background:#18181b;color:#fff}.toggle-button[aria-pressed="true"]{background:#16a34a}.#password-box{display:grid;gap:.8rem}.#password-display{padding:.75rem .8rem;border:1px solid rgba(24,24,27,.2);border-radius:.7rem;font-size:1.1rem}.keypad{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem}.keypad button{padding:.8rem;border:0;border-radius:.7rem;background:#fff;color:#18181b;box-shadow:inset 0 0 0 1px rgba(24,24,27,.1)}.password-actions{display:flex;justify-content:space-between;gap:.75rem}.#password-error{margin:0;min-height:1.1rem;color:#dc2626}.#private-tools{display:none}.#private-tools.unlocked{display:grid;gap:.75rem}.#restore-flash{position:fixed;inset:0;pointer-events:none;opacity:0;background:radial-gradient(circle at center,rgba(255,255,255,.94),rgba(255,255,255,.33) 18%,rgba(22,163,74,.2) 38%,rgba(22,163,74,0) 58%);z-index:120}.#restore-flash.flash{animation:restore-flash .75s ease-out}.@keyframes restore-flash{0%{opacity:0;transform:scale(1.2)}25%{opacity:1}100%{opacity:0;transform:scale(1)}}.fact-popup{position:fixed;right:1.75rem;bottom:5.5rem;max-width:min(26rem,60vw);padding:.75rem 1rem;border-radius:1rem;background:rgba(255,255,255,.88);box-shadow:0 14px 30px rgba(24,24,27,.12);animation:fact-rise .45s ease-out forwards;border:1px solid rgba(24,24,27,.08)}@keyframes fact-rise{0%{opacity:0;transform:translateY(8px) scale(.96)}100%{opacity:1;transform:translateY(0) scale(1)}}.celebration-burst{position:fixed;border-radius:50%;pointer-events:none;z-index:50;background:radial-gradient(circle,rgba(255,255,255,.98),rgba(251,191,36,.95) 18%,rgba(251,191,36,0) 55%);animation:celebration-pop .9s ease-out forwards}.@keyframes celebration-pop{0%{opacity:1;transform:translate(-50%,-50%) scale(.2)}25%{opacity:1}100%{opacity:0;transform:translate(-50%,-50%) scale(3.5)}}.reset-backdrop{position:fixed;inset:0;background:rgba(15,23,42,.35);display:grid;place-items:center;opacity:0;visibility:hidden;transition:opacity .2s ease,visibility .2s ease;z-index:200}.reset-backdrop.open{opacity:1;visibility:visible}.reset-dialog,.final-dialog{background:#fff;border-radius:1.25rem;box-shadow:0 24px 60px rgba(15,23,42,.18);padding:1.4rem 1.6rem;max-width:min(92vw,22rem);display:grid;gap:1rem}.final-dialog{position:fixed;inset:0;margin:auto;display:none;z-index:220}.final-dialog.open{display:grid;background:rgba(255,255,255,.94);place-items:center}.reset-dialog h2,.final-dialog h2{margin:0 0 .2rem;font-size:clamp(1.5rem,5vw,2.1rem);line-height:1.1}.reset-blur{margin:0;color:#4b5563}.reset-actions{display:flex;justify-content:flex-end;gap:.65rem}.reset-actions button{padding:.75rem 1rem;border:0;border-radius:.8rem;font-weight:700}.reset-cancel{background:#e5e7eb;color:#111827}.reset-confirm{background:#dc2626;color:#fff}.shutdown-message-layer,.reconstruct-message-layer{position:fixed;inset:0;display:grid;place-items:center;pointer-events:none}.shutdown-message-layer{z-index:210;background:transparent;color:#fff;text-shadow:0 4px 18px #600;font-size:clamp(4rem,18vw,12rem);font-weight:1000;letter-spacing:.08em}.shutdown-message-layer span{animation:shutdown-text-pulse .8s steps(2,end) infinite}.reconstruct-message-layer{z-index:220;background:rgba(22,163,74,.25);color:#fff;text-shadow:0 4px 18px #064e3b;font-size:clamp(2.4rem,10vw,7rem);font-weight:900;letter-spacing:.04em;animation:reconstruct-jitter .2s steps(2,end) infinite}.body .collapsible{transition:transform .28s ease,opacity .28s ease,filter .28s ease,scale .28s ease!important}body.shutdown-chaos{filter:contrast(1.35) saturate(1.5) hue-rotate(25deg);animation:ui-jitter .17s steps(2,end) infinite}body.shutdown-chaos #event-status{transform:translateX(5px) skewX(-5deg);filter:blur(.6px)}body.shutdown-chaos .shutdown-message-layer span{animation:shutdown-glitch .12s steps(2,end) infinite}body.reconstructing{animation:reconstruct-jitter .2s steps(2,end) infinite}@keyframes shutdown-text-pulse{50%{opacity:.42;transform:scale(.94)}}@keyframes shutdown-glitch{0%{transform:translate(4px,-2px) skewX(8deg)}50%{transform:translate(-5px,2px) skewX(-8deg);color:#ffb4b4}}@keyframes ui-jitter{0%{transform:translate(1px,-1px) rotate(.15deg)}50%{transform:translate(-1px,1px) rotate(-.15deg)}}@keyframes green-flash{0%,100%{background:rgba(22,163,74,.18)}50%{background:rgba(34,197,94,.72)}}@keyframes reconstruct-jitter{0%{filter:brightness(1.15) hue-rotate(-8deg)}50%{filter:brightness(.92) hue-rotate(8deg)}}@media(prefers-reduced-motion:reduce){.shutdown-message-layer span,.reconstruct-message-layer,body.shutdown-chaos,body.reconstructing{animation-duration:.5s}}#reset-visual-layer{position:fixed;inset:0;z-index:300;pointer-events:none;overflow:hidden;opacity:0;transition:opacity .35s ease;background:rgba(0,0,0,.18)}#reset-visual-layer.active{opacity:1}.reset-black-hole{position:absolute;left:50%;top:50%;width:min(34vw,360px);height:min(34vw,360px);transform:translate(-50%,-50%) scale(.15);border-radius:50%;background:radial-gradient(circle,rgba(0,0,0,.96) 0%,rgba(13,13,17,.95) 24%,rgba(26,26,31,.82) 42%,rgba(10,10,12,.4) 58%,rgba(0,0,0,0) 72%);box-shadow:0 0 0 14px rgba(255,255,255,.025),0 0 26px rgba(0,0,0,.8),0 0 120px rgba(0,0,0,.82),inset 0 0 18px rgba(255,255,255,.06);animation:black-hole-pull 5s cubic-bezier(.16,.78,.28,1) forwards}.reset-black-hole::before,.reset-black-hole::after{content:"";position:absolute;inset:-16%;border-radius:50%;border:2px solid rgba(255,255,255,.15);animation:black-hole-ring 2.8s linear infinite}.reset-black-hole::after{inset:-30%;border-color:rgba(255,255,255,.08);animation-duration:4s}.reset-stars{position:absolute;inset:0;pointer-events:none}.reset-star{position:absolute;left:var(--x);top:var(--y);width:var(--size);height:var(--size);border-radius:50%;background:rgba(0,0,0,.9);box-shadow:0 0 8px rgba(0,0,0,.8);opacity:0;transform:translate(-50%,-50%) scale(.2);animation:star-burst var(--dur) ease-out forwards;animation-delay:var(--delay)}@keyframes black-hole-pull{0%{opacity:0;transform:translate(-50%,-50%) scale(.08) rotate(0deg)}10%{opacity:1}60%{opacity:1;transform:translate(-50%,-50%) scale(1.08) rotate(540deg)}100%{opacity:.12;transform:translate(-50%,-50%) scale(1.5) rotate(1200deg)}}@keyframes black-hole-ring{0%{transform:rotate(0deg) scale(.92);opacity:.72}50%{transform:rotate(180deg) scale(1.05);opacity:1}100%{transform:rotate(360deg) scale(.92);opacity:.72}}@keyframes star-burst{0%{opacity:0;transform:translate(-50%,-50%) scale(.18)}12%{opacity:1}100%{opacity:0;transform:translate(calc(var(--tx)), calc(var(--ty))) scale(1.75)}}body.reset-sequence{overflow:hidden}body.reset-sequence .collapsible,body.reset-sequence main,body.reset-sequence .drawer,body.reset-sequence #event-status{filter:brightness(.72) saturate(.7)}#reset-warp{position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle,rgba(255,255,255,.46) 0%,rgba(255,255,255,.24) 12%,rgba(0,0,0,.06) 29%,rgba(0,0,0,.7) 64%,rgba(0,0,0,.9) 100%);opacity:0;mix-blend-mode:screen;animation:warp-flash 1.2s ease-out forwards}@keyframes warp-flash{0%{opacity:0;transform:scale(1.35) rotate(0deg) skewX(8deg)}18%{opacity:1}55%{opacity:1;transform:scale(1.08) rotate(16deg) skewX(-8deg)}100%{opacity:0;transform:scale(1.85) rotate(25deg) skewX(8deg)}}
  </style>
</head>
<body>
  <button class="collapsible" id="reset-progress" type="button">RESET ALL PROGRESS</button>
  <button class="collapsible" id="clock-toggle" type="button" aria-label="Show time played" aria-expanded="false">🕒</button>
  <section id="time-panel" class="collapsible" aria-live="polite"><p id="time-played">Time Played: 0 days, 0 hours, 0 minutes, 0 seconds.</p></section>
  <main class="collapsible">
    <p id="count" aria-live="polite">Clicks: 0</p>
    <button id="action-button" type="button" aria-label="Click the F emblem"><img src="f-button.svg" alt="Golden F compass emblem"></button>
    <p id="timer-label" aria-live="polite">10 Seconds | Pirate Shop Token Chance: 1/137,500</p>
  </main>
  <aside class="drawer collapsible" id="rebirth-drawer" aria-label="Rebirth settings">
    <button class="edge-toggle" id="rebirth-toggle" type="button" aria-label="Open rebirth panel" aria-expanded="false" aria-controls="rebirth-content">›</button>
    <div class="rebirth-list" id="rebirth-content" aria-hidden="true">
      <div class="bubble"><p>Rebirth</p><small id="rebirth-count">Rebirths: 0</small></div>
      <div class="bubble"><p>Pirate Shop Token Chance</p><small id="chance-display">1/137,500</small></div>
      <div class="bubble"><p>Pirate Shop Tokens | PERMANENT: <span id="token-count">0</span></p></div>
      <div class="bubble auto-row"><p>Auto rebirth<small>Rebirth every 100 clicks</small></p><button class="toggle-button" id="rebirth-auto" type="button" aria-pressed="false">Auto Off</button></div>
    </div>
  </aside>
  <aside class="drawer collapsible" id="access-drawer" aria-label="Tyran's panel only">
    <button class="edge-toggle" id="access-toggle" type="button" aria-label="Open tyran's panel only" aria-expanded="false" aria-controls="access-content"><span class="rainbow" aria-hidden="true">[ ]</span></button>
    <div class="access-content" id="access-content" aria-hidden="true">
      <h2 class="panel-heading">tyran's panel only</h2>
      <div class="password-box" id="password-box">
        <input id="password-display" type="password" aria-label="Four-digit password" placeholder="Enter 4-digit code" readonly inputmode="numeric" autocomplete="off" maxlength="4">
        <div class="keypad" id="keypad" aria-label="Numeric keypad"></div>
        <div class="password-actions"><button class="clear-key" id="password-clear" type="button">Clear</button><button id="password-submit" type="button">Enter</button></div>
        <p id="password-error" aria-live="polite"></p>
      </div>
      <div id="private-tools">
        <div class="bubble auto-row"><p>Autoclicker<small>Use only if needed</small></p><button class="toggle-button" id="clicker-toggle" type="button" aria-pressed="false">Off</button></div>
        <button class="bonus-button" type="button" data-add="1000">Add 1,000 Clicks</button>
        <button class="bonus-button" type="button" data-add="10000">Add 10,000 Clicks</button>
        <button class="bonus-button" type="button" data-add="100000">Add 100,000 Clicks</button>
      </div>
    </div>
  </aside>
  <div id="celebration-layer" aria-hidden="true"></div>
  <p id="event-status" aria-live="polite">10 Seconds | Pirate Shop Token Chance: 1/137,500</p>
  <div id="restore-flash" aria-hidden="true"></div>
  <div class="reset-backdrop" id="reset-backdrop" role="dialog" aria-modal="true"><section class="reset-dialog" id="reset-dialog"></section></div>
  <section class="final-dialog" id="final-dialog" role="dialog" aria-modal="true"></section>
  <div id="reset-visual-layer" aria-hidden="true"></div>
  <script>
    const SAVE_KEY='click-counter-save',TIME_KEY='click-counter-time',BASE_TOKEN_ODDS=137500,PASSWORD='3516';
    let clicks=0,rebirths=0,pirateTokens=0,autoRebirth=false,autoclicker=false,autoclickerTimer=null,phase='rolling',countdown=10,phaseTimer=null,previousFactIndex=-1,timePlayed=0,lastTimeTick=Date.now();
    let shutdownAudioContext=null,shutdownAlertTimer=null;
    try{const saved=JSON.parse(localStorage.getItem(SAVE_KEY)||'null');if(saved&&Number.isSafeInteger(saved.clicks)&&saved.clicks>=0)clicks=saved.clicks;if(saved&&Number.isSafeInteger(saved.rebirths)&&saved.rebirths>=0)rebirths=saved.rebirths;if(saved&&Number.isSafeInteger(saved.pirateTokens)&&saved.pirateTokens>=0)pirateTokens=saved.pirateTokens;autoRebirth=Boolean(saved&&saved.autoRebirth);if(saved&&typeof saved.autoclicker==='boolean')autoclicker=saved.autoclicker;const elapsed=Number(localStorage.getItem(TIME_KEY)||'0');if(Number.isFinite(elapsed)&&elapsed>=0)timePlayed=elapsed;lastTimeTick=Date.now()}catch(e){console.warn('Could not load saved game.',e)}
    const $=s=>document.querySelector(s),tokenOdds=()=>Math.max(1,BASE_TOKEN_ODDS-rebirths*1001);
    function saveGame(){try{localStorage.setItem(SAVE_KEY,JSON.stringify({clicks,rebirths,pirateTokens,autoRebirth,autoclicker}));localStorage.setItem(TIME_KEY,String(Math.floor(timePlayed)))}catch(e){console.warn('Could not save game.',e)}}
    function formatPlayedTime(total){const n=Math.max(0,Math.floor(total)),d=Math.floor(n/86400),h=Math.floor(n%86400/3600),m=Math.floor(n%3600/60),s=n%60;return `Time Played: ${d} days, ${h} hours, ${m} minutes, ${s} seconds.`}
    function updateUI(){$('#count').textContent=`Clicks: ${clicks.toLocaleString()}`;$('#rebirth-count').textContent=`Rebirths: ${rebirths.toLocaleString()}`;$('#token-count').textContent=pirateTokens.toLocaleString();$('#chance-display').textContent=`1/${tokenOdds().toLocaleString()}`;$('#timer-label').textContent=`${countdown} Seconds | Pirate Shop Token Chance: 1/${tokenOdds().toLocaleString()}`;$('#event-status').textContent=`${countdown} Seconds | Pirate Shop Token Chance: 1/${tokenOdds().toLocaleString()}`;$('#rebirth-auto').textContent=autoRebirth?'Auto On':'Auto Off';$('#rebirth-auto').setAttribute('aria-pressed',String(autoRebirth));$('#clicker-toggle').textContent=autoclicker?'On':'Off';$('#clicker-toggle').setAttribute('aria-pressed',String(autoclicker));}
    const soundPresets=[['sawtooth',[110,55,82]],['square',[660,880,1320]],['triangle',[440,330,220]],['sine',[880,660,990]],['square',[196,392,784]],['sawtooth',[130,196,98]],['triangle',[523,659,784]],['sine',[330,220,165]]];
    function playRandomClickSound(){try{const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;const ctx=new AC(),now=ctx.currentTime,p=soundPresets[Math.floor(Math.random()*soundPresets.length)];const osc=ctx.createOscillator(),gain=ctx.createGain();osc.type=p[0];osc.frequency.setValueAtTime(p[1][Math.floor(Math.random()*p[1].length)],now);gain.gain.setValueAtTime(0.0001,now);gain.gain.exponentialRampToValueAtTime(0.08,now+0.01);gain.gain.exponentialRampToValueAtTime(0.0001,now+0.12);osc.connect(gain);gain.connect(ctx.destination);osc.start(now);osc.stop(now+0.14)}catch(e){}}
    function playShutdownWarning(){try{const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;if(!shutdownAudioContext)shutdownAudioContext=new AC();shutdownAudioContext.resume().catch(()=>{});const osc=shutdownAudioContext.createOscillator(),gain=shutdownAudioContext.createGain();osc.type='sawtooth';osc.frequency.setValueAtTime(130,shutdownAudioContext.currentTime);gain.gain.setValueAtTime(0.0001,shutdownAudioContext.currentTime);gain.gain.exponentialRampToValueAtTime(0.06,shutdownAudioContext.currentTime+0.02);gain.gain.exponentialRampToValueAtTime(0.0001,shutdownAudioContext.currentTime+0.18);osc.connect(gain);gain.connect(shutdownAudioContext.destination);osc.start();osc.stop(shutdownAudioContext.currentTime+0.2)}catch(e){}}
    function stopShutdownWarning(){if(shutdownAlertTimer!==null){clearInterval(shutdownAlertTimer);shutdownAlertTimer=null}}
    function setDrawer(ds,bs,cs,openLabel,closeLabel){const drawer=$(ds),button=$(bs),content=$(cs),open=drawer.classList.toggle('open');button.setAttribute('aria-expanded',String(open));button.setAttribute('aria-label',open?closeLabel:openLabel);content.setAttribute('aria-hidden',String(!open));}
    $('#rebirth-toggle').addEventListener('click',()=>setDrawer('#rebirth-drawer','#rebirth-toggle','#rebirth-content','Open rebirth panel','Close rebirth panel'));
    $('#access-toggle').addEventListener('click',()=>setDrawer('#access-drawer','#access-toggle','#access-content','Open tyran\'s panel only','Close tyran\'s panel only'));
    $('#clock-toggle').addEventListener('click',()=>{const p=$('#time-panel'),open=p.classList.toggle('open');$('#clock-toggle').setAttribute('aria-expanded',String(open))});
    $('#action-button').addEventListener('click',()=>{playRandomClickSound();awardClicks(1)});
    $('#rebirth-auto').addEventListener('click',()=>{autoRebirth=!autoRebirth;if(autoRebirth){const earned=Math.floor(clicks/100);clicks%=100;rebirths+=earned}updateUI();saveGame()});
    function restartAutoclicker(){if(autoclickerTimer!==null)clearInterval(autoclickerTimer);autoclickerTimer=autoclicker?setInterval(()=>awardClicks(1),100):null}
    $('#clicker-toggle').addEventListener('click',()=>{autoclicker=!autoclicker;restartAutoclicker();updateUI();saveGame()});
    document.querySelectorAll('.bonus-button').forEach(b=>b.addEventListener('click',()=>awardClicks(Number(b.dataset.add))));
    ['1','2','3','4','5','6','7','8','9','⌫','0','↵'].forEach(v=>{const key=document.createElement('button');key.type='button';key.textContent=v;key.setAttribute('aria-label',v==='⌫'?'Backspace':v==='↵'?'Submit':'Digit '+v);key.addEventListener('click',()=>{const display=$('#password-display');if(v==='⌫'){display.value=display.value.slice(0,-1);return}if(v==='↵'){if(display.value===PASSWORD){$('#password-box').style.display='none';$('#private-tools').classList.add('unlocked');$('#password-error').textContent='';}else{$('#password-error').textContent='Incorrect code.';display.value='';}return}if(display.value.length<4){display.value+=v;$('#password-error').textContent='';}});$('#keypad').appendChild(key)});
    $('#password-clear').addEventListener('click',()=>{$('#password-display').value='';$('#password-error').textContent=''});
    $('#password-submit').addEventListener('click',()=>{if($('#password-display').value===PASSWORD){$('#password-box').style.display='none';$('#private-tools').classList.add('unlocked');$('#password-error').textContent='';}else{$('#password-error').textContent='Incorrect code.';$('#password-display').value='';}});

    const resetBackdrop=$('#reset-backdrop'),resetDialog=$('#reset-dialog'),finalDialog=$('#final-dialog');let firstTimer=null,secondTimer=null;
    function closeReset(){resetBackdrop.classList.remove('open');finalDialog.classList.remove('open');if(firstTimer){clearInterval(firstTimer);firstTimer=null}if(secondTimer){clearInterval(secondTimer);secondTimer=null}}
    function startCountdown(button,label,done){let seconds=10;button.disabled=true;button.textContent=`${label} (${seconds})`;const timer=setInterval(()=>{seconds--;if(seconds<=0){clearInterval(timer);button.disabled=false;button.textContent=label;done&&done();return}button.textContent=`${label} (${seconds})`},1000)}
    function triggerResetSequence(){
      if (window.__resetSequenceRunning) return;
      window.__resetSequenceRunning = true;
      closeReset();
      document.body.classList.add('reset-sequence');
      const layer = $('#reset-visual-layer');
      layer.innerHTML = '';
      layer.classList.add('active');
      const hole = document.createElement('div');
      hole.className = 'reset-black-hole';
      layer.appendChild(hole);

      setTimeout(() => {
        layer.innerHTML = '';
        const starLayer = document.createElement('div');
        starLayer.className = 'reset-stars';
        const starCount = 220;
        for (let i = 0; i < starCount; i++) {
          const star = document.createElement('span');
          star.className = 'reset-star';
          const size = (Math.random() * 6 + 2).toFixed(2) + 'px';
          const x = (Math.random() * 100).toFixed(2) + '%';
          const y = (Math.random() * 100).toFixed(2) + '%';
          const tx = ((Math.random() * 220 - 110).toFixed(2)) + 'px';
          const ty = ((Math.random() * 220 - 110).toFixed(2)) + 'px';
          const duration = (Math.random() * 1.8 + 1.1).toFixed(2) + 's';
          const delay = (Math.random() * 0.6).toFixed(2) + 's';
          star.style.setProperty('--size', size);
          star.style.setProperty('--x', x);
          star.style.setProperty('--y', y);
          star.style.setProperty('--tx', tx);
          star.style.setProperty('--ty', ty);
          star.style.setProperty('--dur', duration);
          star.style.setProperty('--delay', delay);
          starLayer.appendChild(star);
        }
        layer.appendChild(starLayer);

        setTimeout(() => {
          const warp = document.createElement('div');
          warp.id = 'reset-warp';
          layer.appendChild(warp);

          setTimeout(() => {
            layer.classList.remove('active');
            layer.innerHTML = '';
            document.body.classList.remove('reset-sequence');
            document.body.classList.remove('shutdown', 'shutdown-chaos', 'reconstructing');
            $('#event-status').textContent = `${countdown} Seconds | Pirate Shop Token Chance: 1/${tokenOdds().toLocaleString()}`;
            window.__resetSequenceRunning = false;
          }, 1200);
        }, 10000);
      }, 5000);

      setTimeout(() => {
        clicks = 0;
        rebirths = 0;
        pirateTokens = 0;
        autoRebirth = false;
        autoclicker = false;
        restartAutoclicker();
        phase = 'rolling';
        countdown = 10;
        updateUI();
        saveGame();
      }, 15000);
    }
    function resetTemporaryProgress(){triggerResetSequence()}
    function openFinalConfirmation(){resetBackdrop.classList.remove('open');finalDialog.innerHTML='<h2 id="final-heading">Reset ALL Progress?<br>Pirate Shop Tokens Will Be Deleted.</h2><p class="reset-blur">Continue to reset options. Time played is always kept.</p><div class="reset-actions"><button class="reset-cancel" type="button" data-reset-cancel="true">Cancel</button><button class="reset-confirm" type="button" data-reset-confirm="true">Reset</button></div>';finalDialog.classList.add('open');}
    $('#reset-progress').addEventListener('click',()=>{resetDialog.innerHTML='<h2 id="reset-heading">Reset Progress?</h2><p class="reset-blur">Continue to reset options. Time played is always kept.</p><div class="reset-actions"><button class="reset-cancel" type="button">Cancel</button><button class="reset-confirm" type="button">Continue</button></div>';resetBackdrop.classList.add('open');const confirmButton=resetDialog.querySelector('.reset-confirm'),cancelButton=resetDialog.querySelector('.reset-cancel');cancelButton.addEventListener('click',closeReset);confirmButton.addEventListener('click',openFinalConfirmation);});
    finalDialog.addEventListener('click',(event)=>{const cancel=event.target.closest('[data-reset-cancel="true"]');const confirm=event.target.closest('[data-reset-confirm="true"]');if(cancel){closeReset();return}if(confirm){resetTemporaryProgress();closeReset();}});
    document.addEventListener('keydown',e=>{if(e.key==='Escape')closeReset()});

    const facts=[
      'Octopuses have three hearts, and two stop beating while they swim.','A group of flamingos is called a flamboyance.','Bananas are berries, but strawberries are not.','The Moon moves away from Earth by about 3.8 cm each year.','A day on Venus is longer than a year on Venus.','The shortest war in history lasted 38 to 45 minutes.','Hummingbirds can fly backwards.','Some stars can actually be blue, white, or red depending on temperature.','The Eiffel Tower can grow by several inches in summer because of heat.','A group of owls is called a parliament.','The human brain is about 60% fat.','The word “volcano” comes from the Roman god Vulcan.','There are more possible moves in chess than atoms in the universe.','A cloud can weigh hundreds of tonnes.','Cows have best friends and can become stressed when separated.','Penguins have knees hidden beneath their feathers.','The Pacific Ocean is larger than all of Earth’s land combined.','A rainbow is actually a full circle in the sky, but the ground usually blocks the bottom half.','The first known use of the word “robot” appeared in a 1920 play.','A jellyfish has no brain, heart, or bones.','The great white shark has electroreceptors that detect the electric fields of prey.','The honeybee can recognize human faces.','A blue whale’s heart is the size of a small car.','The word “muscle” comes from the Latin word for little mouse.','Some mushrooms glow in the dark.','A chameleon’s tongue can be longer than its body.','There are more stars in the universe than grains of sand on Earth.','The Amazon rainforest produces about 20% of the world’s oxygen.','Bats are the only mammals that can truly fly.','The first computer bug was a real moth.','An octopus has three hearts.','A group of crows is called a murder.','The longest mountain range is underwater.','Wombat poop is cube-shaped.','The word “alphabet” comes from the first two Greek letters, alpha and beta.','Some frogs can survive freezing and thaw later.','The Great Wall of China is not visible from the Moon with the naked eye.','A day on Mars is slightly longer than a day on Earth.','Sharks existed before trees.','Some bamboo species flower only once every few decades.','The chemical symbol for gold is Au.','The chemical symbol for silver is Ag.','The capital of Iceland is Reykjavík.','Earth’s atmosphere is mostly nitrogen.','A narwhal’s tusk is actually a giant tooth.','The elephant is the only mammal that cannot jump.','The pharaohs of Egypt were often depicted with red ochre on their skin.','A single atom can be as big as a grain of sand in a telescope image.','The outside of a banana peel is slippery because of a waxy coating.','Some dogs can smell certain diseases in human breath or skin.','The first email was sent in 1971.','A zebra’s stripes are unique to each individual.','The human body contains enough carbon to make about 900 pencils.','A day on Jupiter lasts about 10 hours.','The word “nerd” was popularized by Dr. Seuss.','The moon is slowly moving away from Earth.','A standard deck of cards has 52 cards.','The world’s largest desert is actually Antarctica.','A giraffe’s tongue is blue-black to protect against sunburn.','Some butterflies can taste with their feet.'];
    function showRandomFact(){if(phase!=='rolling')return;const existing=document.querySelectorAll('.fact-popup');if(existing.length>=3)existing[0].remove();const popup=document.createElement('section');popup.className='fact-popup';popup.textContent=facts[Math.floor(Math.random()*facts.length)];document.body.appendChild(popup);setTimeout(()=>popup.remove(),4200)}
    function startCelebration(message,awardToken,showConfetti=true){if(phase!=='rolling')return;phase='celebration';if(awardToken){pirateTokens++;updateUI();saveGame()}document.body.classList.toggle('celebrating',true);const banner=document.createElement('div');banner.className='fact-popup';banner.textContent=message;document.body.appendChild(banner);setTimeout(()=>banner.remove(),1800);if(showConfetti){for(let i=0;i<16;i++){const burst=document.createElement('span');burst.className='celebration-burst';const size=Math.random()*18+12;burst.style.width=`${size}px`;burst.style.height=`${size}px`;burst.style.left=`${Math.random()*100}%`;burst.style.top=`${Math.random()*100}%`;burst.style.setProperty('--dx',(Math.random()*180-90).toFixed(0)+'px');burst.style.setProperty('--dy',(Math.random()*180-90).toFixed(0)+'px');burst.style.animationDelay=`${(Math.random()*0.25).toFixed(2)}s`;burst.style.transform=`translate(-50%,-50%)`;burst.style.setProperty('background','radial-gradient(circle,rgba(255,255,255,.95),rgba(251,191,36,.92) 18%,rgba(251,191,36,0) 58%)');document.body.appendChild(burst);setTimeout(()=>burst.remove(),900)}}setTimeout(()=>{phase='rolling';document.body.classList.toggle('celebrating',false);},1800)}
    function startShutdown(){if(phase==='shutdown')return;phase='shutdown';countdown=60;document.body.classList.add('shutdown');$('#event-status').textContent=`${countdown} Seconds Until Shutdown`;playShutdownWarning();shutdownAlertTimer=setInterval(()=>{if(phase!=='shutdown')return;playShutdownWarning();},700)}
    function awardClicks(amount){if(phase!=='rolling')return;clicks=Math.min(Number.MAX_SAFE_INTEGER,clicks+amount);if(autoRebirth){const earned=Math.floor(clicks/100);if(earned>0){clicks%=100;rebirths+=earned}}updateUI();saveGame()}
    function rollForToken(){if(phase!=='rolling')return;if(Math.random()<1/tokenOdds())startCelebration('Pirate Shop Token found!',true,true);else countdown=10}
    updateUI();saveGame();
    setInterval(()=>{timePlayed+=(Date.now()-lastTimeTick)/1000;lastTimeTick=Date.now();$('#time-played').textContent=formatPlayedTime(timePlayed);saveGame()},1000);
    setInterval(()=>{if(phase!=='rolling')return;countdown--;if(countdown<=0)rollForToken();if(phase==='rolling'){const label=`${countdown} Seconds | Pirate Shop Token Chance: 1/${tokenOdds().toLocaleString()}`;$('#timer-label').textContent=label;$('#event-status').textContent=label;}},1000);
    setInterval(showRandomFact,5000);
  </script>
