<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="f-button.svg">
  <title>Pirate Shop Token Clicker</title>
  <style>
    *{box-sizing:border-box}body{min-height:100vh;margin:0;display:grid;place-items:center;overflow:hidden;background:#f4f4f5;color:#18181b;font-family:system-ui,sans-serif}button{font:inherit;cursor:pointer}#count,#timer-label,#event-status{font-weight:700}#count,#event-status,#timer-label{margin:0}#count,#timer-label{padding:1rem}#reset-progress,#clock-toggle,#access-toggle,#rebirth-toggle,.toggle-button,.edge-toggle,.clear-key,#password-submit,.bonus-button,.switch-button,.button,.summary-button,.close-button{font:inherit}body .collapsible{transition:transform .28s ease,opacity .28s ease,filter .28s ease,scale .28s ease!important}body.shutdown-chaos{filter:contrast(1.35) saturate(1.5) hue-rotate(25deg);animation:ui-jitter .17s steps(2,end) infinite}body.shutdown-chaos #event-status{transform:translateX(5px) skewX(-5deg);filter:blur(.6px)}body.shutdown-chaos .shutdown-message-layer span{animation:shutdown-glitch .12s steps(2,end) infinite}body.reconstructing{animation:reconstruct-jitter .2s steps(2,end) infinite}.rainbow-credit{margin:0 0 .25rem;display:block;font-size:1.1rem;line-height:1.2;font-weight:900;letter-spacing:.06em;text-transform:none;text-align:center;background:linear-gradient(90deg,#ff5f6d,#ffc371,#8be9fd,#7afca2,#c084fc,#f472b6,#ff5f6d);background-size:200% auto;-webkit-background-clip:text;background-clip:text;color:transparent;animation:rainbow-shift 5s linear infinite}@keyframes rainbow-shift{0%{background-position:0% 50%}100%{background-position:200% 50%}}@keyframes shutdown-text-pulse{50%{opacity:.42;transform:scale(.94)}}@keyframes shutdown-glitch{0%{transform:translate(4px,-2px) skewX(8deg)}50%{transform:translate(-5px,2px) skewX(-8deg);color:#ffb4b4}}@keyframes ui-jitter{0%{transform:translate(1px,-1px) rotate(.15deg)}50%{transform:translate(-1px,1px) rotate(-.15deg)}}@keyframes green-flash{0%,100%{background:rgba(22,163,74,.18)}50%{background:rgba(34,197,94,.72)}}@keyframes reconstruct-jitter{0%{filter:brightness(1.15) hue-rotate(-8deg)}50%{filter:brightness(.92) hue-rotate(8deg)}}@media(prefers-reduced-motion:reduce){.shutdown-message-layer span,.reconstruct-message-layer,body.shutdown-chaos,body.reconstructing,.rainbow-credit{animation-duration:.5s}}
  </style>
</head>
<body>
  <button class="collapsible" id="reset-progress" type="button">RESET ALL PROGRESS</button>
  <button class="collapsible" id="clock-toggle" type="button" aria-label="Show time played" aria-expanded="false">🕒</button>
  <section id="time-panel" class="collapsible" aria-live="polite"><p id="time-played">Time Played: 0 days, 0 hours, 0 minutes, 0 seconds.</p></section>
  <main class="collapsible">
    <p class="rainbow-credit" aria-label="Made By tyran, WAWA, cart">Made By tyran, WAWA, cart</p>
    <p id="count" aria-live="polite">Clicks: 0</p>
    <button id="action-button" type="button" aria-label="Click the F emblem"><img src="f-button.svg" alt="Golden F compass emblem"></button>
    <p id="timer-label" aria-live="polite">10 Seconds | Pirate Shop Token Chance: 1/137,500</p>
  </main>
  <aside class="drawer collapsible" id="rebirth-drawer" aria-label="Rebirth settings">
    <button class="edge-toggle" id="rebirth-toggle" type="button" aria-label="Open rebirth panel" aria-expanded="false" aria-controls="rebirth-content">›</button>
    <div class="rebirth-list" id="rebirth-content" aria-hidden="true">
      <div class="bubble"><p>Rebirth</p><small id="rebirth-count">Rebirths: 0</small></div>
      <div class="bubble"><p>Pirate Shop Token Chance</p><small id="chance-display">1/137,500</small></div>
      <div class="bubble"><p>Pirate Shop Tokens | PERMANENT: <span id="token-count">0</span></p></div>
      <div class="bubble auto-row"><p>Auto rebirth<small>Rebirth every 100 clicks</small></p><button class="toggle-button" id="rebirth-auto" type="button" aria-pressed="false">Auto Off</button></div>
      <div class="bubble auto-row"><p>Auto reset<small>Resets every 5,000 clicks</small></p><button class="toggle-button" id="reset-auto" type="button" aria-pressed="false">Reset Off</button></div>
    </div>
  </aside>
  <aside class="drawer collapsible" id="access-drawer" aria-label="Tyran's panel only">
    <button class="edge-toggle" id="access-toggle" type="button" aria-label="Open tyran's panel only" aria-expanded="false" aria-controls="access-content"><span class="rainbow" aria-hidden="true">›</span></button>
    <div class="access-content" id="access-content" aria-hidden="true">
      <h2 class="panel-heading">tyran's panel only</h2>
      <div class="password-box" id="password-box">
        <input id="password-display" type="password" aria-label="Four-digit password" placeholder="Enter 4-digit code" readonly inputmode="numeric" autocomplete="off" maxlength="4">
        <div class="keypad" id="keypad" aria-label="Numeric keypad"></div>
        <div class="password-actions"><button class="clear-key" id="password-clear" type="button">Clear</button><button id="password-submit" type="button">Enter</button></div>
        <p id="password-error" aria-live="polite"></p>
      </div>
      <div id="private-tools">
        <div class="bubble auto-row"><p>Autoclicker<small>Use only if needed</small></p><button class="toggle-button" id="clicker-toggle" type="button" aria-pressed="false">Off</button></div>
        <button class="bonus-button" type="button" data-add="1000">Add 1,000 Clicks</button>
        <button class="bonus-button" type="button" data-add="10000">Add 10,000 Clicks</button>
        <button class="bonus-button" type="button" data-add="100000">Add 100,000 Clicks</button>
      </div>
    </div>
  </aside>
  <div id="celebration-layer" aria-hidden="true"></div>
  <p id="event-status" aria-live="polite">10 Seconds | Pirate Shop Token Chance: 1/137,500</p>
  <div id="restore-flash" aria-hidden="true"></div>
  <div class="reset-backdrop" id="reset-backdrop" role="dialog" aria-modal="true"><section class="reset-dialog" id="reset-dialog"></section></div>
  <section class="final-dialog" id="final-dialog" role="dialog" aria-modal="true"></section>
  <script>
    const SAVE_KEY='click-counter-save',TIME_KEY='click-counter-time',BASE_TOKEN_ODDS=137500,PASSWORD='3516';
    let clicks=0,rebirths=0,pirateTokens=0,autoRebirth=false,autoclicker=false,autoclickerTimer=null,phase='rolling',countdown=10,phaseTimer=null,previousFactIndex=-1,timePlayed=0,lastTimeTick=Date.now(),shutdownAudioContext=null,shutdownAlertTimer=null;
    try{const saved=JSON.parse(localStorage.getItem(SAVE_KEY)||'null');if(saved&&Number.isSafeInteger(saved.clicks)&&saved.clicks>=0)clicks=saved.clicks;if(saved&&Number.isSafeInteger(saved.rebirths)&&saved.rebirths>=0)rebirths=saved.rebirths;if(saved&&Number.isSafeInteger(saved.pirateTokens)&&saved.pirateTokens>=0)pirateTokens=saved.pirateTokens;if(typeof saved?.autoRebirth==='boolean')autoRebirth=saved.autoRebirth;if(typeof saved?.autoclicker==='boolean')autoclicker=saved.autoclicker;if(saved?.lastTimeTick&&Number.isFinite(saved.lastTimeTick))lastTimeTick=saved.lastTimeTick;const elapsedSeconds=Math.max(0,(Date.now()-lastTimeTick)/1000);timePlayed=(Number(localStorage.getItem(TIME_KEY))||0)+elapsedSeconds}catch(e){console.warn('Save load failed',e)}
    const $=s=>document.querySelector(s),tokenOdds=()=>Math.max(1,BASE_TOKEN_ODDS-rebirths*1001);
    function saveGame(){try{localStorage.setItem(SAVE_KEY,JSON.stringify({clicks,rebirths,pirateTokens,autoRebirth,autoclicker,lastTimeTick:Date.now()}));localStorage.setItem(TIME_KEY,String(Math.floor(timePlayed)))}catch(e){console.warn('Save failed',e)}}
    function formatPlayedTime(total){const n=Math.max(0,Math.floor(total)),d=Math.floor(n/86400),h=Math.floor(n%86400/3600),m=Math.floor(n%3600/60),s=n%60;return `Time Played: ${d} days, ${h} hours, ${m} minutes, ${s} seconds.`}
    function updateUI(){$('#count').textContent=`Clicks: ${clicks.toLocaleString()}`;$('#rebirth-count').textContent=`Rebirths: ${rebirths.toLocaleString()}`;$('#token-count').textContent=pirateTokens.toLocaleString();$('#chance-display').textContent=`1/${tokenOdds().toLocaleString()}`;$('#timer-label').textContent=`${countdown} Seconds | Pirate Shop Token Chance: 1/${tokenOdds().toLocaleString()}`;$('#event-status').textContent=`${countdown} Seconds | Pirate Shop Token Chance: 1/${tokenOdds().toLocaleString()}`;document.getElementById('rebirth-auto').textContent=autoRebirth?'Auto On':'Auto Off';document.getElementById('clicker-toggle').textContent=autoclicker?'On':'Off';document.getElementById('clicker-toggle').setAttribute('aria-pressed',String(autoclicker))}
    const soundPresets=[['sawtooth',[110,55,82]],['square',[660,880,1320]],['triangle',[440,330,220]],['sine',[880,660,990]],['square',[196,392,784]],['sawtooth',[130,196,98]],['triangle',[523,659,1046]],['square',[220,330,440]]];
    function playRandomClickSound(){try{const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;const ctx=new AC(),now=ctx.currentTime,p=soundPresets[Math.floor(Math.random()*soundPresets.length)];const osc=ctx.createOscillator(),gain=ctx.createGain();osc.type=p[0];osc.frequency.setValueAtTime(p[1][Math.floor(Math.random()*p[1].length)],now);gain.gain.setValueAtTime(0.0001,now);gain.gain.exponentialRampToValueAtTime(0.08,now+0.01);gain.gain.exponentialRampToValueAtTime(0.0001,now+0.12);osc.connect(gain);gain.connect(ctx.destination);osc.start(now);osc.stop(now+0.12)}catch(e){console.warn('Click sound failed',e)}}
    function playShutdownWarning(){try{const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;if(!shutdownAudioContext)shutdownAudioContext=new AC();shutdownAudioContext.resume().catch(()=>{});const now=shutdownAudioContext.currentTime;const osc=shutdownAudioContext.createOscillator();const gain=shutdownAudioContext.createGain();osc.type='sawtooth';osc.frequency.setValueAtTime(220,now);gain.gain.setValueAtTime(0.0001,now);gain.gain.exponentialRampToValueAtTime(0.05,now+0.04);gain.gain.exponentialRampToValueAtTime(0.0001,now+0.18);osc.connect(gain);gain.connect(shutdownAudioContext.destination);osc.start(now);osc.stop(now+0.18)}catch(e){console.warn('Shutdown warning failed',e)}}
    function stopShutdownWarning(){if(shutdownAlertTimer!==null){clearInterval(shutdownAlertTimer);shutdownAlertTimer=null}}
    function setDrawer(ds,bs,cs,openLabel,closeLabel){const drawer=$(ds),button=$(bs),content=$(cs),open=drawer.classList.toggle('open');button.setAttribute('aria-expanded',String(open));button.setAttribute('aria-label',open?closeLabel:openLabel);content.setAttribute('aria-hidden',String(!open));if(!open)content.style.display='none';else content.style.display='block'}
    $('#rebirth-toggle').addEventListener('click',()=>setDrawer('#rebirth-drawer','#rebirth-toggle','#rebirth-content','Open rebirth panel','Close rebirth panel'));
    $('#access-toggle').addEventListener('click',()=>setDrawer('#access-drawer','#access-toggle','#access-content',"Open tyran's panel only","Close tyran's panel only"));
    $('#clock-toggle').addEventListener('click',()=>{const p=$('#time-panel'),open=p.classList.toggle('open');$('#clock-toggle').setAttribute('aria-expanded',String(open));p.setAttribute('aria-hidden',String(!open))});
    $('#action-button').addEventListener('click',()=>{playRandomClickSound();awardClicks(1)});
    $('#rebirth-auto').addEventListener('click',()=>{autoRebirth=!autoRebirth;updateUI();saveGame()});
    function restartAutoclicker(){if(autoclickerTimer!==null)clearInterval(autoclickerTimer);autoclickerTimer=autoclicker?setInterval(()=>awardClicks(1),100):null}
    $('#clicker-toggle').addEventListener('click',()=>{autoclicker=!autoclicker;restartAutoclicker();updateUI();saveGame()});
    document.querySelectorAll('.bonus-button').forEach(b=>b.addEventListener('click',()=>awardClicks(Number(b.dataset.add))));
    ['1','2','3','4','5','6','7','8','9','⌫','0','↵'].forEach(v=>{const key=document.createElement('button');key.type='button';key.textContent=v;key.setAttribute('aria-label',v==='⌫'?'Backspace':v==='↵'?'Submit':v);key.className='key';document.getElementById('keypad').appendChild(key);key.addEventListener('click',()=>{const display=document.getElementById('password-display');if(v==='⌫'){display.value=display.value.slice(0,-1)}else if(v==='↵'){document.getElementById('password-submit').click()}else if(display.value.length<4){display.value+=v}})});
    $('#password-clear').addEventListener('click',()=>{$('#password-display').value='';$('#password-error').textContent=''});
    $('#password-submit').addEventListener('click',()=>{if($('#password-display').value===PASSWORD){$('#password-box').style.display='none';$('#private-tools').classList.add('unlocked');$('#password-error').textContent=''}else{$('#password-error').textContent='Incorrect code.';$('#password-display').value=''}});
    const resetBackdrop=$('#reset-backdrop'),resetDialog=$('#reset-dialog'),finalDialog=$('#final-dialog');let firstTimer=null,secondTimer=null;
    function closeReset(){resetBackdrop.classList.remove('open');finalDialog.classList.remove('open');if(firstTimer){clearInterval(firstTimer);firstTimer=null}if(secondTimer){clearInterval(secondTimer);secondTimer=null}}
    function startCountdown(button,label,done){let seconds=10;button.disabled=true;button.textContent=`${label} (${seconds})`;const timer=setInterval(()=>{seconds--;if(seconds<=0){clearInterval(timer);button.disabled=false;button.textContent=label;done&&done()}else{button.textContent=`${label} (${seconds})`}},1000)}
    function resetTemporaryProgress(){clicks=0;rebirths=0;autoRebirth=false;autoclicker=false;restartAutoclicker();updateUI();saveGame()}
    function openFinalConfirmation(){resetBackdrop.classList.remove('open');finalDialog.innerHTML='<h2 id="final-heading">Reset ALL Progress?<br>Pirate Shop Tokens Will Be Deleted.</h2><p class="reset-blur">Continue to reset options. Time played is always kept.</p><div class="reset-actions"><button class="button secondary" id="cancel-reset">Cancel</button><button class="button danger" id="confirm-reset">Reset</button></div>';
      finalDialog.classList.add('open');document.getElementById('cancel-reset').addEventListener('click',closeReset);document.getElementById('confirm-reset').addEventListener('click',()=>{resetTemporaryProgress();closeReset()})}
    $('#reset-progress').addEventListener('click',()=>{resetDialog.innerHTML='<h2 id="reset-heading">Reset Progress?</h2><p class="reset-blur">Continue to reset options. Time played is always kept.</p><div class="reset-actions"><button class="button secondary" id="cancel-reset">Cancel</button><button class="button danger" id="confirm-reset">Reset</button></div>';
      resetBackdrop.classList.add('open');document.getElementById('cancel-reset').addEventListener('click',closeReset);document.getElementById('confirm-reset').addEventListener('click',()=>{openFinalConfirmation()})});
    document.addEventListener('keydown',e=>{if(e.key==='Escape')closeReset()});
    const facts=['Octopuses have three hearts, and two stop beating while they swim.','A group of flamingos is called a flamboyance.','Bananas are berries, but strawberries are not.','The Moon moves away from Earth by about 3.8 cm per year.','The dot over a lowercase i or j is called a tittle.','A group of crows is sometimes called a murder.','Sharks existed before trees.','Saturn would float in water if a large enough ocean existed.','Some cats chirp when watching birds.','The word alphabet comes from the Greek letters alpha and beta.','A cloud can weigh hundreds of tonnes.','Cows have best friends and can become stressed when separated.','There are more possible chess games than atoms in the observable universe.','Some bamboo species can grow very rapidly in a day.','A jiffy is an informal name for a very short time interval.'];
    function showRandomFact(){if(phase!=='rolling')return;const existing=document.querySelectorAll('.fact-popup');if(existing.length>=3)existing[0].remove();const popup=document.createElement('section');popup.className='fact-popup';popup.innerHTML='<div class="fact-bar">Tyran Fact</div><p>'+facts[Math.floor(Math.random()*facts.length)]+'</p>';document.body.appendChild(popup);setTimeout(()=>popup.classList.add('visible'),10);setTimeout(()=>{popup.classList.remove('visible');setTimeout(()=>popup.remove(),400)},4000)}
    function startCelebration(message,awardToken,showConfetti=true){if(phase!=='rolling')return;phase='celebration';if(awardToken){pirateTokens++;updateUI();saveGame()}document.body.classList.toggle('celebrating',showConfetti);if(showConfetti){const burst=document.createElement('div');burst.className='celebration-burst';document.body.appendChild(burst);setTimeout(()=>burst.remove(),1200)}setTimeout(()=>{phase='rolling';document.body.classList.remove('celebrating');if(awardToken)countdown=10;updateUI();saveGame();},1400)}
    function startShutdown(){if(phase==='shutdown')return;phase='shutdown';countdown=60;document.body.classList.add('shutdown');$('#event-status').textContent=`${countdown} Seconds Until Shutdown`;
      if(shutdownAlertTimer===null)shutdownAlertTimer=setInterval(()=>{playShutdownWarning();if(countdown<=0){stopShutdownWarning();phase='rolling';document.body.classList.remove('shutdown');countdown=10;updateUI();saveGame()}} ,1100)}
    function awardClicks(amount){if(phase!=='rolling')return;clicks=Math.min(Number.MAX_SAFE_INTEGER,clicks+amount);if(autoRebirth){const earned=Math.floor(clicks/100);if(earned>0){clicks%=100;rebirths+=earned;saveGame()}}updateUI();saveGame()}
    function rollForToken(){if(phase!=='rolling')return;if(Math.random()<1/tokenOdds())startCelebration('Pirate Shop Token found!',true,true);else countdown=10}
    updateUI();saveGame();
    setInterval(()=>{timePlayed+=(Date.now()-lastTimeTick)/1000;lastTimeTick=Date.now();$('#time-played').textContent=formatPlayedTime(timePlayed);saveGame()},1000);
    setInterval(()=>{if(phase!=='rolling')return;countdown--;if(countdown<=0)rollForToken();if(phase==='rolling'){const label=`${countdown} Seconds | Pirate Shop Token Chance: 1/${tokenOdds().toLocaleString()}`;$('#timer-label').textContent=label;$('#event-status').textContent=label}} ,1000);
    setInterval(showRandomFact,5000);
  </script>
</body>
</html>
