    function showRandomFact(){if(phase!=='rolling')return;const existing=document.querySelectorAll('.fact-popup');if(existing.length>=3)existing[0].remove();const popup=document.createElement('section');popup.className='fact-popup collapsible';popup.setAttribute('aria-label',"Tyran's ad: random fun fact");const bar=document.createElement('div');bar.className='fact-bar';const tab=document.createElement('span');tab.className='fact-tab';tab.textContent="tyran's ad";const close=document.createElement('button');close.type='button';close.className='fact-close';close.textContent='×';close.setAttribute('aria-label','Close popup');close.addEventListener('click',()=>popup.remove());bar.append(tab,close);const body=document.createElement('div');body.className='fact-body';const p=document.createElement('p');let index=Math.floor(Math.random()*facts.length);if(index===previousFactIndex)index=(index+1)%facts.length;previousFactIndex=index;p.textContent=facts[index];body.append(p);popup.append(bar,body);document.body.append(popup);const margin=8,maxLeft=Math.max(margin,innerWidth-popup.offsetWidth-margin),maxTop=Math.max(margin,innerHeight-popup.offsetHeight-margin);popup.style.left=`${margin+Math.random()*(maxLeft-margin)}px`;popup.style.top=`${margin+Math.random()*(maxTop-margin)}px`;let drag=null;bar.addEventListener('pointerdown',e=>{if(e.target===close)return;const r=popup.getBoundingClientRect();drag={x:e.clientX-r.left,y:e.clientY-r.top};bar.setPointerCapture(e.pointerId)});bar.addEventListener('pointermove',e=>{if(!drag)return;popup.style.left=`${Math.max(0,Math.min(innerWidth-popup.offsetWidth,e.clientX-drag.x))}px`;popup.style.top=`${Math.max(0,Math.min(innerHeight-popup.offsetHeight,e.clientY-drag.y))}px`});bar.addEventListener('pointerup',()=>drag=null);bar.addEventListener('pointercancel',()=>drag=null)}
    function startCelebration(message,awardToken,showConfetti=true){if(phase!=='rolling')return;phase='celebration';if(awardToken){pirateTokens++;updateUI();saveGame()}document.body.classList.toggle('celebrating',showConfetti);let remaining=10;$('#event-status').textContent=`${remaining} Seconds | ${message}`;const layer=$('#celebration-layer');layer.replaceChildren();let confettiTimer=null;if(showConfetti){const colors=['#ef4444','#f97316','#eab308','#22c55e','#3b82f6','#a855f7','#ec4899'];confettiTimer=setInterval(()=>{for(let i=0;i<8;i++){const piece=document.createElement('i');piece.className='confetti';piece.style.left=`${Math.random()*100}vw`;piece.style.background=colors[Math.floor(Math.random()*colors.length)];piece.style.setProperty('--drift',`${(Math.random()-.5)*220}px`);piece.style.animationDuration=`${2+Math.random()*2}s`;layer.append(piece);piece.addEventListener('animationend',()=>piece.remove())}},120)}phaseTimer=setInterval(()=>{remaining--;$('#event-status').textContent=`${remaining} Seconds | ${message}`;if(remaining<=0){clearInterval(phaseTimer);phaseTimer=null;if(confettiTimer)clearInterval(confettiTimer);layer.replaceChildren();document.body.classList.remove('celebrating');startShutdown()}},1000)}
    function startShutdown(){if(phase==='shutdown')return;phase='shutdown';countdown=60;document.body.classList.add('shutdown');$('#event-status').textContent=`${countdown} Seconds Until Shutdown`;playShutdownWarning();stopShutdownWarning();shutdownAlertTimer=setInterval(playShutdownWarning,2000);phaseTimer=setInterval(()=>{countdown--;$('#event-status').textContent=`${countdown} Seconds Until Shutdown`;if(countdown<=0){clearInterval(phaseTimer);phaseTimer=null;stopShutdownWarning();document.body.classList.remove('shutdown');clicks=0;rebirths=0;autoRebirth=false;autoclicker=false;restartAutoclicker();phase='rolling';countdown=10;$('#celebration-layer').replaceChildren();updateUI();saveGame();$('#restore-flash').classList.remove('flash');void $('#restore-flash').offsetWidth;$('#restore-flash').classList.add('flash');const label=`10 Seconds | Pirate Shop Token Chance: 1/${tokenOdds().toLocaleString()}`;$('#timer-label').textContent=label;$('#event-status').textContent=label}},1000)}
    function awardClicks(amount){if(phase!=='rolling')return;clicks=Math.min(Number.MAX_SAFE_INTEGER,clicks+amount);if(autoRebirth){const earned=Math.floor(clicks/100);if(earned>0){clicks%=100;rebirths+=earned}}updateUI();saveGame();if(!autoRebirth&&clicks>1000000)startCelebration('Click limit exceeded! Shutdown sequence starting.',false,false)}
    function rollForToken(){if(phase!=='rolling')return;if(Math.random()<1/tokenOdds())startCelebration('Pirate Shop Token found!',true,true);else countdown=10}
    updateUI();saveGame();
    setInterval(()=>{timePlayed+=(Date.now()-lastTimeTick)/1000;lastTimeTick=Date.now();$('#time-played').textContent=formatPlayedTime(timePlayed);saveGame()},1000);
    setInterval(()=>{if(phase!=='rolling')return;countdown--;if(countdown<=0)rollForToken();if(phase==='rolling'){const label=`${countdown} Seconds | Pirate Shop Token Chance: 1/${tokenOdds().toLocaleString()}`;$('#timer-label').textContent=label;$('#event-status').textContent=label}},1000);
    setInterval(showRandomFact,5000);
