<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="f-button.svg">
  <title>Click Counter</title>
  <style>
    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      min-height: 100vh;
    }

    body {
      min-height: 100vh;
      margin: 0;
      display: grid;
      place-items: center;
      overflow: hidden;
      background: #f4f4f5;
      color: #18181b;
      font-family: system-ui, sans-serif;
    }

    button { font: inherit; cursor: pointer; }

    #reset-progress {
      position: fixed;
      z-index: 4;
      top: 14px;
      left: 14px;
      padding: 10px 14px;
      border: 2px solid #991b1b;
      border-radius: 8px;
      background: #dc2626;
      color: #fff;
      font-size: .8rem;
      font-weight: 800;
    }

    #reset-progress:hover { background: #b91c1c; }

    main {
      display: grid;
      justify-items: center;
      gap: 12px;
      transition: opacity 60s linear, filter 60s linear, scale 60s linear;
    }

    #count { margin: 0; font-size: 1.35rem; font-weight: 700; }

    #action-button {
      width: min(60vw, 240px);
      aspect-ratio: 1;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: transparent;
      transition: transform 150ms ease;
    }

    #action-button:hover { transform: scale(1.05); }
    #action-button:active { transform: scale(.97); }

    #action-button img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    #timer-label {
      max-width: min(90vw, 380px);
      margin: 0;
      text-align: center;
      font-size: .95rem;
      font-weight: 650;
    }

    .drawer {
      position: fixed;
      z-index: 3;
      width: min(360px, calc(100vw - 48px));
      padding: 20px;
      border: 1px solid #e4e4e7;
      background: #fff;
      box-shadow: 0 12px 35px rgb(24 24 27 / 18%);
      transition: transform 350ms cubic-bezier(.2, .8, .2, 1),
                  opacity 60s linear, filter 60s linear, scale 60s linear;
    }

    #rebirth-drawer {
      top: 50%;
      left: 0;
      border-left: 0;
      border-radius: 0 16px 16px 0;
      transform: translate(-100%, -50%);
    }

    #rebirth-drawer.open { transform: translate(0, -50%); }

    .edge-toggle {
      position: absolute;
      display: grid;
      place-items: center;
      width: 44px;
      height: 52px;
      border: 1px solid #e4e4e7;
      background: #fff;
      font-size: 1.5rem;
    }

    #rebirth-toggle {
      top: 20px;
      right: -44px;
      border-left: 0;
      border-radius: 0 12px 12px 0;
      box-shadow: 6px 6px 18px rgb(24 24 27 / 10%);
    }

    .rebirth-list { display: grid; gap: 10px; }

    .bubble {
      padding: 12px 14px;
      border: 1px solid #e4e4e7;
      border-radius: 14px;
      background: #f8fafc;
      font-weight: 650;
    }

    .bubble p { margin: 0; }

    .bubble small {
      display: block;
      margin-top: 4px;
      color: #52525b;
      font-size: .85rem;
      font-weight: 500;
    }

    .auto-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .toggle-button {
      min-width: 90px;
      padding: 11px 14px;
      border: 0;
      border-radius: 10px;
      background: #dc2626;
      color: #fff;
      font-weight: 750;
    }

    .toggle-button[aria-pressed="true"] { background: #16a34a; }

    #access-drawer {
      right: 0;
      bottom: 0;
      padding: 18px;
      border-right: 0;
      border-bottom: 0;
      border-radius: 16px 0 0 0;
      transform: translate(100%, 100%);
    }

    #access-drawer.open { transform: translate(0, 0); }

    #access-toggle {
      top: -50px;
      left: -50px;
      width: 50px;
      height: 50px;
      border-right: 0;
      border-bottom: 0;
      border-radius: 14px 0 0 0;
      box-shadow: -6px -6px 18px rgb(24 24 27 / 10%);
    }

    .rainbow { display: inline-block; animation: rainbow 2s linear infinite; }

    @keyframes rainbow {
      0% { color: #ef4444; }
      17% { color: #f97316; }
      33% { color: #eab308; }
      50% { color: #22c55e; }
      67% { color: #3b82f6; }
      83% { color: #a855f7; }
      100% { color: #ef4444; }
    }

    .access-content {
      display: grid;
      gap: 10px;
      max-height: min(65vh, 520px);
      overflow: auto;
    }

    .panel-heading { margin: 0; font-size: 1rem; }

    .password-box { display: grid; gap: 10px; }

    #password-display {
      width: 100%;
      padding: 11px;
      border: 1px solid #d4d4d8;
      border-radius: 9px;
      background: #fafafa;
      font-size: 1.25rem;
      letter-spacing: .45em;
      text-align: center;
    }

    .keypad {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 7px;
    }

    .keypad button {
      min-height: 44px;
      border: 1px solid #d4d4d8;
      border-radius: 8px;
      background: #f4f4f5;
      font-size: 1.05rem;
      font-weight: 700;
    }

    .keypad button:hover { background: #e4e4e7; }

    .password-actions { display: flex; gap: 8px; }

    .password-actions button, .bonus-button {
      flex: 1;
      padding: 10px;
      border: 0;
      border-radius: 8px;
      background: #2563eb;
      color: #fff;
      font-weight: 700;
    }

    .password-actions .clear-key { background: #71717a; }
    .password-actions button:hover, .bonus-button:hover { filter: brightness(.92); }

    #password-error {
      min-height: 1.2em;
      margin: 0;
      color: #dc2626;
      font-size: .85rem;
    }

    #private-tools { display: none; gap: 9px; }
    #private-tools.unlocked { display: grid; }
    .bonus-button { width: 100%; }

    .fact-popup {
      position: fixed;
      z-index: 5;
      width: min(240px, calc(100vw - 16px));
      overflow: hidden;
      border: 1px solid #cbd0d8;
      border-radius: 9px;
      background: #fff;
      color: #272a30;
      box-shadow: 0 8px 26px rgb(0 0 0 / 24%);
      animation: popup-appear 180ms ease-out;
      transition: opacity 60s linear, filter 60s linear, scale 60s linear;
    }

    .fact-bar {
      min-height: 34px;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 4px 5px 4px 10px;
      background: #e5e7eb;
      cursor: grab;
      touch-action: none;
      user-select: none;
    }

    .fact-bar:active { cursor: grabbing; }
    .fact-tab { margin-right: auto; font-size: .75rem; font-weight: 650; }

    .fact-close {
      width: 26px;
      height: 26px;
      border: 0;
      border-radius: 5px;
      background: transparent;
      font-size: 1.1rem;
    }

    .fact-close:hover { background: #dc2626; color: #fff; }

    .fact-body {
      min-height: 92px;
      display: grid;
      align-content: center;
      padding: 14px;
      font-size: .875rem;
      line-height: 1.45;
    }

    .fact-body p { margin: 0; }

    #celebration-layer {
      position: fixed;
      z-index: 8;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .confetti {
      position: absolute;
      top: -18px;
      width: 10px;
      height: 16px;
      animation: confetti-fall 3s linear forwards;
    }

    @keyframes confetti-fall {
      to { transform: translate3d(var(--drift), 110vh, 0) rotate(900deg); opacity: .8; }
    }

    body.celebrating #action-button {
      animation: party 500ms ease-in-out infinite alternate;
    }

    @keyframes party {
      to { filter: drop-shadow(0 0 24px #facc15); transform: scale(1.07) rotate(4deg); }
    }

    body.shutdown .collapsible {
      opacity: 0;
      filter: blur(8px);
      scale: .03;
      pointer-events: none;
    }

    body.shutdown-chaos {
      filter: contrast(1.35) saturate(1.5) hue-rotate(18deg);
      animation: ui-jitter .16s steps(2, end) infinite;
      transition: none;
    }

    @keyframes ui-jitter {
      0% { transform: translate(1px, -1px) rotate(.12deg); }
      50% { transform: translate(-1px, 1px) rotate(-.12deg); }
      100% { transform: translate(1px, -1px) rotate(.12deg); }
    }

    .shutdown-overlay {
      position: fixed;
      inset: 0;
      display: grid;
      place-items: center;
      z-index: 220;
      pointer-events: none;
      opacity: 0;
      transition: opacity .2s ease;
      background: rgba(5, 10, 20, .28);
    }

    .shutdown-overlay.visible {
      opacity: 1;
    }

    .shutdown-overlay span {
      display: block;
      font-weight: 1000;
      font-size: clamp(4rem, 18vw, 12rem);
      line-height: 1;
      letter-spacing: .08em;
      color: #fff;
      text-shadow: 0 8px 30px rgba(0,0,0,.7), 0 0 30px rgba(255,90,90,.5);
      animation:
        shutdown-pulse .8s steps(2, end) infinite,
        shutdown-glitch .12s steps(2, end) infinite;
    }

    @keyframes shutdown-pulse {
      50% { opacity: .45; transform: scale(.94); }
    }

    @keyframes shutdown-glitch {
      0% { transform: translate(3px, -2px) skewX(8deg); }
      50% { transform: translate(-4px, 2px) skewX(-8deg); color: #ffd4d4; }
      100% { transform: translate(3px, -2px) skewX(8deg); }
    }

    .reconstruct-overlay {
      position: fixed;
      inset: 0;
      display: grid;
      place-items: center;
      z-index: 230;
      pointer-events: none;
      opacity: 0;
      background: rgba(22, 163, 74, .2);
      color: #fff;
      text-shadow: 0 6px 20px rgba(0,0,0,.6);
      transition: opacity .2s ease;
    }

    .reconstruct-overlay.visible {
      opacity: 1;
      animation: reconstruct-flash .45s steps(2, end) infinite;
    }

    @keyframes reconstruct-flash {
      0%, 100% { background: rgba(22, 163, 74, .16); }
      50% { background: rgba(34, 197, 94, .72); }
    }

    .reconstruct-overlay span {
      display: block;
      font-size: clamp(2.5rem, 9vw, 7rem);
      font-weight: 900;
      line-height: 1;
      letter-spacing: .04em;
    }

    body.reconstructing {
      animation: reconstruct-jitter .2s steps(2, end) infinite;
    }

    @keyframes reconstruct-jitter {
      0% { filter: brightness(1.12) hue-rotate(-8deg); }
      50% { filter: brightness(.94) hue-rotate(8deg); }
      100% { filter: brightness(1.12) hue-rotate(-8deg); }
    }

    #event-status {
      position: fixed;
      z-index: 10;
      right: 12px;
      bottom: 12px;
      left: 12px;
      margin: 0 auto;
      width: fit-content;
      max-width: calc(100vw - 24px);
      padding: 10px 16px;
      border: 1px solid #d4d4d8;
      border-radius: 12px;
      background: rgb(255 255 255 / 94%);
      text-align: center;
      font-weight: 750;
      box-shadow: 0 4px 18px rgb(0 0 0 / 12%);
    }

    #restore-flash {
      position: fixed;
      z-index: 9;
      inset: 0;
      background: #fff;
      opacity: 0;
      pointer-events: none;
    }

    #restore-flash.flash { animation: restore-flash 800ms ease-out; }

    @keyframes restore-flash {
      0% { opacity: 0; }
      35% { opacity: .9; }
      100% { opacity: 0; }
    }

    @keyframes popup-appear {
      from { opacity: 0; transform: scale(.96); }
      to { opacity: 1; transform: scale(1); }
    }

